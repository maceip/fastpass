FROM alpine:latest as build

RUN apk update && apk add --no-cache \
        cmake clang-dev openssl-dev openssl-libs-static curl 

RUN cd /root && \
    curl 'https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-musl/rustup-init' --output /root/rustup-init && \
    chmod +x /root/rustup-init && \
    echo '1' | /root/rustup-init --default-toolchain stable-x86_64-unknown-linux-musl --profile minimal && \
    echo 'source /root/.cargo/env' >> /root/.bashrc && \
    rm /root/rustup-init && rm -rf /root/.cargo/registry && rm -rf /root/.cargo/git 




ENV PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.cargo/bin'

RUN --mount=type=cache,target=/root/.cargo/registry/index \
    --mount=type=cache,target=/root/.cargo/registry/cache \
    --mount=type=cache,target=/root/.cargo/git \
    rustup component add rust-src --toolchain stable-x86_64-unknown-linux-musl


COPY . .

RUN cargo build --release --target x86_64-unknown-linux-musl --bin notary-server --target-dir /root 

FROM alpine:latest as runtime

WORKDIR /run
COPY --from=build /root/x86_64-unknown-linux-musl/release/notary-server .

ENTRYPOINT [ "/run/notary-server"]
CMD [ "--config-file", "/root/config.yaml" ]
